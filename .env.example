# --- Security (required) ---
# At least 32 characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-48-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Protects /metrics and /auth-test. Leave empty to disable.
INTERNAL_API_KEY=change-me

# --- Databases (required) ---
DATABASE_URL=sqlite:///database.db
RAG_DATABASE_URL=postgresql+psycopg://astra:astra_password@localhost:5433/astra

# --- LLM provider ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# --- Optional ---
# memory (default) or postgres: where paused agent runs are stored
AGENT_CHECKPOINTER=memory
RATE_LIMIT_PER_MINUTE=120
AI_RATE_LIMIT_PER_MINUTE=20
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost","http://localhost:3000"]
# USD per 1M tokens, used for the cost estimate in /metrics
LLM_INPUT_COST_PER_1M_TOKENS=0
LLM_OUTPUT_COST_PER_1M_TOKENS=0
EMBEDDING_COST_PER_1M_TOKENS=0.02
